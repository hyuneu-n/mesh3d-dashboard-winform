# MeshPnP3D 배포 폴더 — 저장소에 담지 않는 것
#
# 이 폴더는 "압축만 풀면 도는" 배포본이라 실행에 필요한 것이 전부 들어 있다.
# 그대로 커밋하면 4.1 GB 가 되고 GitHub 파일 크기 한도(개당 100 MB)에도 걸린다.
# 아래 것들은 ★용량이 크고 다시 만들 수 있거나 다른 곳에서 받을 수 있는 것★ 이라 제외한다.
# 내려받은 사람이 무엇을 어디서 구해야 하는지는 README.md 에 적어 둔다.

# ── GPU 런타임 (CUDA 12 / cuDNN 9) — 약 1.5 GB ────────────────────────────
# NVIDIA 배포판에서 받거나, ONNX Runtime GPU 패키지를 복원하면 나온다.
app/cu*.dll
app/nvrtc*.dll
app/zlibwapi.dll

# ── 네이티브 라이브러리 — NuGet 복원으로 다시 생긴다 ──────────────────────
app/runtimes/

# ── 신경망 매처 모델 (.onnx) — 약 400 MB ──────────────────────────────────
# 모델은 코드가 아니다. Releases 나 별도 저장소로 배포하는 편이 맞다.
app/models/

# ── 3D 메시 아카이브 — 1.3 GB. 원래도 배포본에 안 넣던 것 ─────────────────
app/data/
*.rtra

# ── 실행하면 다시 생기는 것 ───────────────────────────────────────────────
# ★.gitignore 는 줄 끝 주석을 지원하지 않는다★ — 패턴 뒤에 주석을 붙이면
#   그 공백과 # 까지 전부 패턴의 일부가 되어 아무것도 안 걸린다. 주석은 반드시 윗줄에.
# 지도 캐시. 첫 실행 때 20~30초면 다시 구워진다
app/mapcache/
# 매칭 결과 캐시. 순수 캐시라 지워도 결과가 안 바뀐다
app/matchcache/
# 분석 결과 CSV
app/results/
app/logs/

# ── 빌드 산출물 ───────────────────────────────────────────────────────────
bin/
obj/
*.pdb

# ── 문서 원본(용량 큼) ────────────────────────────────────────────────────
# 스크린샷은 docs/img/ 로 뽑아 두었으므로 원본 pptx 까지 담을 필요는 없다.
*.pptx
~$*

# ── OS·편집기 ─────────────────────────────────────────────────────────────
.vs/
.vscode/
Thumbs.db
desktop.ini
.DS_Store

# ── ONNX Runtime GPU 실행 공급자 — 약 350 MB ──────────────────────────────
# onnxruntime_providers_cuda.dll 하나가 318 MB 로 GitHub 파일 한도(100 MB)를 넘는다.
# Microsoft.ML.OnnxRuntime.Gpu NuGet 패키지를 복원하면 나온다.
app/onnxruntime_providers_cuda.dll
app/onnxruntime_providers_tensorrt.dll

# ── 링커용 .lib — 실행에 쓰이지 않는다 ────────────────────────────────────
*.lib
